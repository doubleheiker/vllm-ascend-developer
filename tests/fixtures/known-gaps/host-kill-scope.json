{
  "schema_version": 2,
  "scenario": "A vLLM service is stopped by its tracked container process group; host fuser only verifies or releases the configured port as a fallback.",
  "cases": [
    {
      "id": "tracked-container-process-group",
      "execution_scope": "container",
      "operation": "service-stop",
      "expected_decision": "allow"
    },
    {
      "id": "host-port-verification",
      "execution_scope": "remote-host",
      "command": "fuser 8080/tcp",
      "expected_decision": "allow-after-group-stop"
    },
    {
      "id": "ambiguous-process-kill",
      "execution_scope": "remote-host",
      "command": "pkill -9 python",
      "expected_decision": "deny"
    }
  ]
}
